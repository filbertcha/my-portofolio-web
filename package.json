{
  "name": "personal-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Personal programmer portfolio with a public site and an admin dashboard",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:seed:force": "npm run db:seed -w backend -- --force",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "admin:create": "npm run admin:create -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "type": "module"
}
