# ------------------------------------------------------------------
# Backend environment
# Copy this file to .env and adjust the values for your machine.
# ------------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
# Local example: postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/personal_portfolio
# Set to "true" when your hosted database requires SSL
DATABASE_SSL=false

# Session
# Generate a long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=replace-this-with-a-long-random-secret
COOKIE_SECURE=false
SESSION_MAX_AGE_DAYS=7

# Frontend origin allowed by CORS (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Initial administrator (used only by `npm run admin:create` / `npm run db:seed`)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
